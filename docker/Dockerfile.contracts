# syntax=docker/dockerfile:1.7

# Stage 1: builder — pinned Rust toolchain, soroban-cli, and build deps.
# This stage is heavy (toolchain + CLI + cargo registry) and is intentionally
# kept out of the final image. Cargo cache mounts keep rebuilds reproducible
# and fast without baking the registry into any layer.
FROM rust:1.78-slim AS builder

# Pin the stellar-cli (soroban-cli) version so WASM output stays reproducible.
ARG STELLAR_CLI_VERSION=21.6.0

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev binaryen \
    && rm -rf /var/lib/apt/lists/*

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    cargo install --locked stellar-cli --version "${STELLAR_CLI_VERSION}" --features opt

WORKDIR /contracts
# Build context is the repository root (see docker/docker-compose.yml's
# `context: ..`), so paths here are relative to the repo root, not a nested
# `soroban-starter-kit/` folder. Every directory below is a workspace member
# declared in the root Cargo.toml, so all of them must be present for cargo
# to resolve the workspace even though only contracts/ is actually compiled.
COPY Cargo.toml Cargo.lock ./
COPY contracts/ ./contracts/
COPY benches/ ./benches/
COPY tests/ ./tests/
COPY fuzz/ ./fuzz/

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/contracts/target \
    for dir in contracts/*/; do \
      [ -f "$dir/Cargo.toml" ] && stellar contract build --manifest-path "$dir/Cargo.toml"; \
    done

# Run wasm-opt -Oz on every compiled WASM to reduce binary size by 10–30%.
# Prints before/after sizes for each file.
RUN echo "=== wasm-opt size reduction ===" && \
    find target/wasm32-unknown-unknown/release -maxdepth 1 -name "*.wasm" | sort | while read wasm; do \
      before=$(stat -c%s "$wasm"); \
      wasm-opt -Oz --output "${wasm}.opt" "$wasm" && mv "${wasm}.opt" "$wasm"; \
      after=$(stat -c%s "$wasm"); \
      pct=$(( (before - after) * 100 / before )); \
      echo "  $(basename $wasm): ${before}B → ${after}B (-${pct}%)"; \
    done

# Stage 2: runtime — only .wasm artifacts and verification scripts.
# No Rust toolchain, cargo registry, or build deps are copied here, keeping
# the final image minimal (well under half the size of the builder image).
FROM debian:bookworm-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /wasm
COPY --from=builder /contracts/target/wasm32-unknown-unknown/release/*.wasm ./

# Verification scripts for checking artifacts and reproducibility.
COPY scripts/verify-wasm.sh scripts/verify-reproducible-wasm.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/verify-wasm.sh /usr/local/bin/verify-reproducible-wasm.sh

ENTRYPOINT ["/usr/local/bin/verify-wasm.sh"]
